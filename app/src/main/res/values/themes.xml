<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window background is the same system role the dynamic colour scheme uses, so the
         first frame matches what Compose draws instead of flashing the platform grey. -->
    <style name="Theme.App" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/system_background_light</item>
    </style>
</resources>
